type matlog_dmesg, domain, coredomain, mlstrustedsubject;
type matlog_dmesg_exec, system_file_type, exec_type, file_type;
type matlog_dmesg_socket, file_type, coredomain_socket, mlstrustedobject;

init_daemon_domain(matlog_dmesg)

allow matlog_dmesg self:global_capability2_class_set syslog;
allow matlog_dmesg kernel:system syslog_read;
allow matlog_dmesg kmsg_device:chr_file r_file_perms;
allow matlog_dmesg self:unix_stream_socket { accept listen };

typeattribute matlog_dmesg pstorefs_reader;
allow matlog_dmesg pstorefs:dir r_dir_perms;
allow matlog_dmesg pstorefs:file r_file_perms;

# MatLog runs as platform_app or platform_app_36 depending on its target SDK
unix_socket_connect(platform_app_all, matlog_dmesg, matlog_dmesg)
allow platform_app_all matlog_dmesg_socket:sock_file getattr;
